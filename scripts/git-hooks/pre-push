#!/bin/sh
# repo-standard pre-push guard. scripts/setup-machine.sh installs it as a git
# template hook (init.templateDir), so every clone and every `git init` gets
# it. It refuses any push that would update or delete main on the remote:
# changes reach main only through merged pull requests (STANDARD.md section 7).
#
# Git passes one line per ref being pushed on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# All lines are checked, so `git push origin feat main`, `feat:main`,
# `HEAD:refs/heads/main` and `:main` (deletion) are all caught, including
# pushes of commits the remote already has.
#
# Two exceptions: repositories that do not follow the standard are left
# alone (a standard repository's .pre-commit-config.yaml has the
# no-commit-to-branch hook, or it has the .github/repo-standard.yml stamp),
# and the first push that creates main on an empty remote (the bootstrap
# commit of new-repo.sh) is allowed.
#
# Not a security boundary: `git push --no-verify` skips it. The main-guard
# workflow reports anything that reaches main without a merged pull request.
# If pre-commit later installs its own pre-push hook, it keeps this one as
# pre-push.legacy and still runs it.
top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$top/.github/repo-standard.yml" ] ||
  grep -qs 'id: no-commit-to-branch' "$top/.pre-commit-config.yaml" || exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      # Creating main where it does not exist yet: the bootstrap push.
      if [ "$remote_sha" = "$zero" ] && [ "$local_sha" != "$zero" ]; then continue; fi
      echo "pre-push: refusing to push to main on '$1'. Push a branch and open a pull request." >&2
      status=1
      ;;
  esac
done
exit "$status"
