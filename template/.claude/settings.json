{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:main *)",
      "PowerShell(git push *:refs/heads/main*)",
      "PowerShell(git push *--no-verify*)",
      "PowerShell(git commit *--no-verify*)"
    ]
  }
}
